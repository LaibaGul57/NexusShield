{
  "expo": {
    "name": "NexusShield",
    "slug": "nexusshield",
    "version": "1.0.0",
    "platforms": [
      "ios",
      "android",
      "web"
    ],
     "sdkVersion": "54.0.0",
    "orientation ": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      },
      "edgeToEdgeEnabled": true
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-web-browser"
    ],
    "extra": {
      "eas": {
        "projectId": "d75b3243-4521-419d-92d2-3bbd3b66976f"
      }
    }
  }
}
